  "semantic_invariants": [
    "section IDs remain stable even when display labels are localized",
    "section names reflect content",
    "role organization dates remain associated",
    "bullets remain associated with their entry",
    "critical contact data is recoverable as text",
    "reading order remains meaningful",
    "page breaks preserve semantic chunks",
    "date precision is never invented for visual consistency"
  ],
  "date_standard": {
    "internal_formats": [
      "YYYY",
      "YYYY-MM",
      "YYYY-MM-DD",
      null
    ],
    "ongoing_representation": "end_date=null and is_current=true",
    "english_month_display": "MMM YYYY – MMM YYYY",
    "english_current_display": "MMM YYYY – Present",
    "range_separator": "en_dash",
    "source_of_truth": "references/DATE_STANDARD.md"
  },
  "defaults": {
    "page_layout": "single-column when submission platform is unknown",
    "body_size_pt_range": [
      10.5,
      12
    ],
    "line_height_multiplier_range": [
      1.15,
      1.35
    ],
    "margin_inch_range": [
      0.55,
      0.85
    ],
    "page_size": "context-dependent: A4 or Letter",
    "note": "Engineering defaults, not universal scientific constants."
  },
  "required_artifact_tests": [
    "human_visual_scan",
    "text_extraction",
    "reading_order",
    "entity_association",
    "date_association",
    "link_integrity",
    "clipping_overflow",
    "editorial_consistency"
  ]
