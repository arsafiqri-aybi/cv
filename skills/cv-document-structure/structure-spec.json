  "semantic_invariants": [
    "section names reflect content",
    "role organization dates remain associated",
    "bullets remain associated with their entry",
    "critical contact data is recoverable as text",
    "reading order remains meaningful",
    "page breaks preserve semantic chunks"
  ],
  "defaults": {
    "page_layout": "single_column_when_submission_platform_unknown",
    "body_size_pt_range": [
      10.5,
      12
    ],
    "line_height_multiplier_range": [
      1.15,
      1.35
    ],
    "margin_in_range": [
      0.55,
      0.85
    ],
    "note": "Engineering defaults, not universal scientific constants."
  },
  "required_artifact_tests": [
    "human_visual_scan",
    "text_extraction",
    "reading_order",
    "entity_association",
    "link_integrity",
    "clipping_overflow"
  ]
}