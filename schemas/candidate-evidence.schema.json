{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CV Candidate Evidence Record",
  "type": "object",
  "required": [
    "candidate_id",
    "evidence_items"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "source_note": {
      "type": "string"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "episode_type",
          "fact",
          "confidence",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "episode_type": {
            "enum": [
              "employment",
              "project",
              "education",
              "certification",
              "volunteer",
              "research",
              "publication",
              "award",
              "other"
            ]
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_date": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              }
            ],
            "description": "Normalized factual date with year, month, or day precision. Do not use display strings such as 'Present'."
          },
          "end_date": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              }
            ],
            "description": "Normalized factual end date. Use null with is_current=true for ongoing entries."
          },
          "fact": {
            "type": "string"
          },
          "context": {
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "contribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "tools_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metric": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "baseline": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "ownership": {
            "enum": [
              "sole",
              "primary",
              "shared",
              "supporting",
              "unknown"
            ]
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_type",
                "description"
              ],
              "properties": {
                "source_type": {
                  "enum": [
                    "user_report",
                    "document",
                    "artifact",
                    "external_record",
                    "manager_or_peer",
                    "system_log",
                    "other"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "reference": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "sensitivity": {
            "enum": [
              "normal",
              "personal",
              "sensitive"
            ]
          },
          "verification_status": {
            "enum": [
              "verified",
              "partially_verified",
              "self_reported",
              "unverified"
            ]
          },
          "allowed_claim_strength": {
            "enum": [
              "direct",
              "bounded",
              "descriptive_only",
              "do_not_use"
            ]
          },
          "is_current": {
            "type": "boolean",
            "default": false,
            "description": "True when the episode is ongoing. If true, end_date must be null."
          },
          "date_source_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional original date wording when preserving source precision/context is useful."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}